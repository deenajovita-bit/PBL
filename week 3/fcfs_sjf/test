#include <stdio.h>
#include "scheduler.h"

int main(void)
{
    Process p[4] = {{1,0,5,0,0,0,0,0},{2,1,3,0,0,0,0,0},
                    {3,2,8,0,0,0,0,0},{4,3,6,0,0,0,0,0}};
    GanttChart g;
    int i;

    sjf(p, 4, &g);                       /* try fcfs() too */
    for (i = 0; i < g.count; i++)
        printf("P%d: %d-%d\n", g.segments[i].pid,
               g.segments[i].start, g.segments[i].end);
    for (i = 0; i < 4; i++)
        printf("P%d CT=%d\n", p[i].pid, p[i].completion_time);
    return 0;
}
